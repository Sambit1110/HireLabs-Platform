NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional override for the legacy parser CLI.
# RESUME_PYTHON_PATH=
# All AI runs on the team's own models: the parser and matcher (model server) and the evaluator (Ollama).
USE_LOCAL_MODELS=true
# Also provides the authenticated PDFPlumber fallback when pdf-parse cannot extract text.
MODEL_SERVER_URL=http://127.0.0.1:8000
OLLAMA_URL=http://127.0.0.1:11434
# Hrittima's November GGUF returns fractional scores and a reason. Use full for full-schema models.
OLLAMA_CANDIDATE_FORMAT=compact
OLLAMA_MODEL=hirelabs-evaluator
# Ollama also fills profile fields when the HireLabs parser is unavailable or incomplete.
# For a protected remote endpoint, use its full /api/generate URL and server-only key:
# OLLAMA_URL=https://your-host.example/api/generate
# OLLAMA_KEY=
# Context window requested from Ollama. Match the Modelfile's num_ctx; longer prompts are refused, not cut.
OLLAMA_NUM_CTX=16384
# How long to wait for the evaluator, in ms (default 35000, at most 55000).
# OLLAMA_TIMEOUT_MS=35000
# Shared secret for a hosted model server (docs/hosting-models.md). Server-only: never NEXT_PUBLIC_.
# MODEL_API_TOKEN=
# Only for a private Hugging Face Space (docs/hirelabs-llm.md): a Hugging Face read token.
# Server-only: never NEXT_PUBLIC_.
# HF_SPACE_TOKEN=
ENABLE_BIAS_CHECK=false
EVALUATOR_PLACEHOLDER=false
# Explain score and role briefs: hirelabs-explainer (own models and rules, default) or
# EVALUATOR_PROVIDER=ollama for the Ollama evaluator at OLLAMA_URL.
# EVALUATOR_PROVIDER=hirelabs

# Matching service (scripts/python/embed_service.py). Needed for "Rank candidates".
EMBED_SERVICE_URL=http://localhost:8000/embed
# Optional: where embed_service.py loads the fine-tuned model from (default: models/hirelabs-matcher)
# MATCHER_MODEL_PATH=models/hirelabs-matcher
# Tests only: EMBED_MOCK=true returns fixed fake vectors. Never set this for a demo.
