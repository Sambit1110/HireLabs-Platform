NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional override for the legacy parser CLI.
# RESUME_PYTHON_PATH=
# All AI runs on the team's own models: the parser and matcher (model server) and the evaluator (Ollama).
USE_LOCAL_MODELS=true
MODEL_SERVER_URL=http://127.0.0.1:8000
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hirelabs-evaluator
# Context window requested from Ollama. Match the Modelfile's num_ctx; longer prompts are refused, not cut.
OLLAMA_NUM_CTX=16384
ENABLE_BIAS_CHECK=false
EVALUATOR_PLACEHOLDER=false

# Matching service (scripts/python/embed_service.py). Needed for "Rank candidates".
EMBED_SERVICE_URL=http://localhost:8000/embed
# Optional: where embed_service.py loads the fine-tuned model from (default: models/hirelabs-matcher)
# MATCHER_MODEL_PATH=models/hirelabs-matcher
# Tests only: EMBED_MOCK=true returns fixed fake vectors. Never set this for a demo.
