# --- Supabase (browser-safe; inlined at build time, rebuild after changing) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Preferred: the project's publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative, used only if the publishable key is not set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Gemini (server-only; never prefix with NEXT_PUBLIC_) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Emergency kill switch for every AI call.
AI_FEATURES_ENABLED=true

# Never add a Supabase service-role / sb_secret_ key here: the app does not need one.
